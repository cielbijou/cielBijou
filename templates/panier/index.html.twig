{% extends 'base.html.twig' %}

{% block title %}Panier - Ciel Bijoux{% endblock %}

{% block body %}
{% for message in app.flashes('panier') %}
<div class="alert alert-success alert-dismissible fade show" role="alert">
    <strong>{{message}}</strong>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
{% endfor %}
<div id="divMessage"></div>
{% if items|length > 0 %}
<div id="plein" class="container mt-4">
    <div class="row">
        {% set prixProd = 0 %}
        {% set total = 0 %}
        {% for Prod in items %}
        {% set produit = Prod.produit[0] %}
        <div id="supp{{produit.id}}">
            <div class="col-12 mb-3">
                <div class="d-flex justify-content-between align-items-center p-4 bg-light shadow-lg rounded">
                    <div class="d-flex align-items-center" style="width: 150px;">
                        <img src="{{asset('images/produit/'~produit.imageProd)}}" class="img-fluid" alt="Produit {{produit.nomProd}}" style="max-height: 100px;">
                    </div>

                    <div class="d-flex flex-column align-items-start" style="width: 250px;">
                        <h5 class="text-dark">{{produit.nomProd}}</h5>
                        <p class="mb-0 text-muted">{{produit.description}}</p>
                    </div>

                    {% if produit.remisePromo is defined %}
                        {% set prixProd = (produit.prixProd * produit.remisePromo)|number_format(2, '.', ' ') %}
                        <div class="d-flex align-items-center" style="width: 120px;">
                            <span><strong>{{prixProd}}€</strong></span>
                        </div>
                    {% else %}
                        {% set prixProd = produit.prixProd %}
                        <div class="d-flex align-items-center" style="width: 120px;">
                            <span><strong>{{prixProd}}€</strong></span>
                        </div>
                    {% endif %}

                    <div class="d-flex align-items-center">
                        <button onClick="moins('{{ path('panier_moins', {'id'  : produit.id}) }}', {{produit.id}}, {{prixProd}}, {{Prod.qte}})" 
                                class="btn btn-outline-secondary btn-sm">-</button>
                        
                        <input type="text" class="form-control text-center mx-2" 
                            id="qte{{produit.id}}" 
                            value="{{Prod.qte}}" 
                            style="width: 50px;" 
                            readonly 
                            data-stock="{{produit.stock}}">

                        <button onClick="plus('{{ path('panier_plus', {'id': produit.id}) }}', {{produit.id}}, {{prixProd}}, {{Prod.qte}})" 
                                class="btn btn-outline-secondary btn-sm">+</button>
                    </div>

                    <a onClick="supprimer('{{ path('panier_remove', {'id'  : produit.id}) }}', {{produit.id}}, {{prixProd * Prod.qte}}, {{Prod.qte}})">
                        <button class="btn btn-danger btn-sm">
                            Supprimer
                        </button>
                    </a>
                </div>
            </div>
            <hr>
        </div>
        {% set total = total + prixProd * Prod.qte %}
        {% endfor %}
        <div class="col-12 mb-3">
            <div class="d-flex justify-content-end mt-4">
                <div class="fs-5">Prix total du panier :</div>
                <div id="total" class="fs-4 text-success fw-bold ms-2">{{total}} €</div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between mt-4">
        <a href="{{path('panier_vider')}}" class="btn btn-danger py-2 px-4 rounded-pill shadow-sm">Vider le panier</a>
        <a href="{{path('commande')}}" id="btn-valider" class="btn btn-primary py-2 px-4 rounded-pill shadow-sm" onclick="return verifierStocksAvantCommande()">Valider le panier</a>
    </div>
</div>
{% else %}
<div class="container d-flex flex-column align-items-center justify-content-center vh-100">
    <div class="text-center">
        <i class="bi bi-cart-x" style="font-size: 80px; color: #adb5bd;"></i>
        
        <h1 class="mt-4">Votre panier est vide</h1>
        <p class="lead text-muted">Il semble que vous n'ayez pas encore ajouté d'articles à votre panier.</p>
        
        <a href="{{ path('catalogue') }}" class="btn btn-primary mt-4">
            <i class="bi bi-shop me-2"></i> Aller au catalogue
        </a>
    </div>
</div>
{% endif %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    function verifierStocks() {
        const problemes = [];
        let tousStocksOk = true;
        
        document.querySelectorAll('[id^="qte"]').forEach(input => {
            const produitId = input.id.replace('qte', '');
            const qte = parseInt(input.value);
            const stock = parseInt(input.dataset.stock);
            
            if (qte > stock) {
                tousStocksOk = false;
                const nomProduit = document.querySelector(`#supp${produitId} h5`).textContent;
                problemes.push({
                    id: produitId,
                    nom: nomProduit,
                    manquant: qte - stock
                });
                
                input.closest('.bg-light').classList.add('border', 'border-danger');
            } else {
                input.closest('.bg-light').classList.remove('border', 'border-danger');
            }
        });

        return {
            valide: tousStocksOk,
            problemes: problemes
        };
    }

    function verifierStocksAvantCommande() {
        const verification = verifierStocks();
        
        if (!verification.valide) {
            const messages = verification.problemes.map(p => 
                `• ${p.nom} : ${p.manquant} unité(s) manquante(s)`
            ).join('\n');
            
            document.getElementById('divMessage').innerHTML = `
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Problèmes de stock :</strong><br>
                    ${messages.replace(/\n/g, '<br>')}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            
            return false;
        }
        return true;
    }

    function updateTotal(amount) {
        const totalElement = document.getElementById('total');
        let total = parseFloat(totalElement.textContent.replace(' €', '').replace(/\s/g, ''));
        total = (total + amount).toFixed(2);
        totalElement.textContent = total + ' €';
        
        if (total <= 0) {
            location.reload();
        }
        verifierStocks();
    }

    function moins(route, id, prix, qte) {
        const currentQte = parseInt(document.getElementById('qte' + id).value);
        
        if (currentQte <= 1) {
            if (confirm('Voulez-vous supprimer ce produit du panier ?')) {
                supprimer(route.replace('moins', 'remove'), id, prix, qte);
            }
            return;
        }

        const xhr = new XMLHttpRequest();
        xhr.onreadystatechange = function() {
            if (xhr.readyState === 4 && xhr.status === 200) {
                document.getElementById('qte' + id).value = currentQte - 1;
                updateTotal(-prix);
            }
        };
        xhr.open("GET", route, true);
        xhr.setRequestHeader("X-Requested-With", "XMLHttpRequest");
        xhr.send();
    }

    function plus(route, id, prix, qte) {
        const currentQte = parseInt(document.getElementById('qte' + id).value);
        const stockMax = parseInt(document.getElementById('qte' + id).dataset.stock);

        if (currentQte >= stockMax) {
            stock('+');
            return;
        }

        const xhr = new XMLHttpRequest();
        xhr.onreadystatechange = function() {
            if (xhr.readyState === 4 && xhr.status === 200) {
                document.getElementById('qte' + id).value = currentQte + 1;
                updateTotal(prix);
            }
        };
        xhr.open("GET", route, true);
        xhr.setRequestHeader("X-Requested-With", "XMLHttpRequest");
        xhr.send();
    }

    function supprimer(route, id, prix, quantite) {
        const xhr = new XMLHttpRequest();
        xhr.onreadystatechange = function() {
            if (xhr.readyState === 4 && xhr.status === 200) {
                document.getElementById('supp' + id).remove();
                updateTotal(-prix);
                
                if (document.querySelectorAll('[id^="supp"]').length === 0) {
                    location.reload();
                }
            }
        };
        xhr.open("GET", route, true);
        xhr.setRequestHeader("X-Requested-With", "XMLHttpRequest");
        xhr.send();
    }

    function stock(indicateur) {
        const divMessage = document.getElementById('divMessage');
        divMessage.innerHTML = `
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Stock insuffisant pour ce produit</strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        `;
        
        setTimeout(() => {
            const alert = divMessage.querySelector('.alert');
            if (alert) {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            }
        }, 3000);
    }
</script>
{% endblock %}
